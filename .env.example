# =============================================================================
# Odyssea registration — SERVER-ONLY secrets
# =============================================================================
# Copy to .env.local (git-ignored) for development, and add the same keys to the
# hosting provider's environment settings for production.
#
# None of these names start with NEXT_PUBLIC_, which is what keeps them out of
# the browser bundle. Never add that prefix to any of them.
# -----------------------------------------------------------------------------

# --- Supabase -----------------------------------------------------------------
# Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings → API Keys → service_role (starts eyJ) or a sb_secret_ key.
# Full database power: server only, never in client code, never committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string: openssl rand -hex 32
# Registration IPs are stored only as an HMAC of this salt, never in the clear.
ODYSSEA_IP_SALT=generate-a-long-random-string

# --- Email: Google SMTP, the club's own mailbox (preferred) -------------------
# Requires 2-Step Verification on that Google account, then
# Google Account → Security → 2-Step Verification → App passwords.
# Use the 16-character App Password here, NOT the account password.
ODYSSEA_SMTP_HOST=smtp.gmail.com
ODYSSEA_SMTP_PORT=465
ODYSSEA_SMTP_USER=skill.and.tell@ensia.edu.dz
ODYSSEA_SMTP_PASSWORD=abcd efgh ijkl mnop

# Gmail only sends as the mailbox you log in with, or an alias verified under
# Gmail → Settings → Accounts → "Send mail as". Keep these in sync.
ODYSSEA_FROM_EMAIL="Odyssea by Skill&Tell <skill.and.tell@ensia.edu.dz>"

# --- Email fallback: Resend (used only when SMTP is not configured) -----------
RESEND_API_KEY=re_your_resend_key

# --- Links inside the confirmation email --------------------------------------
ODYSSEA_SITE_URL=https://your-production-domain.com
ODYSSEA_CONTACT_EMAIL=skill.and.tell@ensia.edu.dz

# -----------------------------------------------------------------------------
# Legacy keys used by the other events (Arcade / MOBai / Eunoia), which query
# Supabase straight from the browser. Odyssea does not use these.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
